POSTGRES_URL=postgresql+asyncpg://crm:crm@localhost:5432/crmassistant
JWT_SECRET=troque-por-string-longa-e-aleatoria
CORS_ORIGINS=*

# RD Station
RD_CLIENT_ID=
RD_CLIENT_SECRET=
RD_REDIRECT_URI=http://localhost:8000/oauth/rd/callback
RD_OAUTH_AUTHORIZE_URL=https://api.rd.services/auth/dialog
RD_OAUTH_TOKEN_URL=https://api.rd.services/auth/token
RD_WEBHOOK_SECRET=
# Front-end que recebe o usuário de volta após autorizar no RD
FRONTEND_URL=http://localhost:5173
# Endereço público da API (no Render vem de RENDER_EXTERNAL_URL). Vazio em desenvolvimento.
API_PUBLIC_URL=

# IA (opcional — sem chave, o chat usa respostas fallback)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_EFFORT=low

# Testes: SKIP_ALEMBIC_ON_STARTUP=1
