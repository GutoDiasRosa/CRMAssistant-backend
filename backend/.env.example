POSTGRES_URL=postgresql+asyncpg://crm:crm@localhost:5432/crmassistant
JWT_SECRET=troque-por-string-longa-e-aleatoria
CORS_ORIGINS=*

# Administrador criado (ou com a senha redefinida) a cada inicialização da API.
# Para trocar e-mail ou senha, altere aqui (ou no painel do Render) e publique de novo.
ADMIN_EMAIL=admin@crmassist.dev
ADMIN_PASSWORD=troque-esta-senha

# RD Station: as credenciais são cadastradas pela tela Integração RD, não por variáveis.
# Front-end que recebe o usuário de volta após autorizar no RD
FRONTEND_URL=http://localhost:5173
# Endereço público da API, usado nas URLs de callback e de webhook do RD Station
# (no Render vem de RENDER_EXTERNAL_URL). Vazio em desenvolvimento.
API_PUBLIC_URL=

# IA (opcional — sem chave, o chat usa respostas fallback)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_EFFORT=low

# Testes: SKIP_ALEMBIC_ON_STARTUP=1
